
<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#101018">
  <title>AnimeKita - Anime Legal</title>
  <style>
    * { box-sizing: border-box; }
    body {
      margin: 0;
      background: #101018;
      color: #f8f8fc;
      font-family: Arial, sans-serif;
    }
    header {
      padding: 20px;
      background: #191925;
      border-bottom: 1px solid #303044;
    }
    .brand { font-size: 25px; font-weight: bold; }
    .brand span { color: #a78bfa; }
    .sub { color: #aaaabc; font-size: 13px; margin-top: 7px; }
    main { max-width: 1000px; margin: auto; padding: 20px; }
    .hero {
      padding: 25px 20px;
      border-radius: 18px;
      background: linear-gradient(135deg, #35205c, #1b3154);
      margin-bottom: 25px;
    }
    .hero h1 { font-size: 29px; margin: 0 0 10px; }
    .hero p { color: #e0d9f7; line-height: 1.6; }
    .official {
      display: inline-block;
      padding: 12px 16px;
      background: #a78bfa;
      color: #171324;
      text-decoration: none;
      font-weight: bold;
      border-radius: 10px;
    }
    input {
      width: 100%;
      padding: 14px;
      margin: 0 0 20px;
      background: #20202d;
      color: white;
      border: 1px solid #414156;
      border-radius: 10px;
      font-size: 16px;
    }
    h2 { font-size: 21px; }
    .grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 14px;
    }
    .card {
      background: #1c1c29;
      border: 1px solid #303044;
      border-radius: 14px;
      overflow: hidden;
    }
    .poster {
      min-height: 135px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 48px;
      background: linear-gradient(140deg, #38265b, #23445b);
    }
    .info { padding: 13px; }
    .info h3 { font-size: 16px; margin: 0 0 8px; }
    .info p {
      font-size: 12px;
      color: #b7b7c9;
      line-height: 1.5;
      min-height: 36px;
    }
    .watch {
      display: block;
      text-align: center;
      padding: 11px 8px;
      margin-top: 10px;
      border-radius: 8px;
      background: #292943;
      color: #d8ccff;
      text-decoration: none;
      font-size: 13px;
      font-weight: bold;
    }
    .note {
      margin-top: 25px;
      padding: 15px;
      background: #20202d;
      border-radius: 12px;
      color: #c6c6d4;
      line-height: 1.7;
      font-size: 13px;
    }
    footer {
      padding: 25px 15px;
      text-align: center;
      color: #9999aa;
      font-size: 12px;
    }
    @media (min-width: 650px) {
      .grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
      .poster { min-height: 190px; }
    }
    @media (min-width: 850px) {
      .grid { grid-template-columns: repeat(4, minmax(0, 1fr)); }
    }
  </style>
</head>
<body>
  <header>
    <div class="brand">Anime<span>Kita</span> 🎌</div>
    <div class="sub">Temukan anime dari sumber resmi</div>
  </header>

  <main>
    <section class="hero">
      <h1>Dunia Anime Ada di Sini!</h1>
      <p>
        Temukan tontonan anime melalui kanal resmi.
        Gratis untuk dijelajahi, mudah digunakan di HP.
      </p>
      <a class="official"
         href="https://www.youtube.com/@MuseIndonesia"
         target="_blank" rel="noopener noreferrer">
        ▶ Kunjungi Muse Indonesia
      </a>
    </section>

    <input id="search" type="search"
      placeholder="Cari anime di katalog..."
      aria-label="Cari anime">

    <h2>📺 Katalog Anime</h2>
    <div class="grid" id="catalog"></div>

    <div class="note">
      <strong>Catatan legalitas</strong><br>
      AnimeKita adalah katalog independen, bukan situs resmi
      Muse Indonesia. Tombol menonton mengarahkan kamu ke
      pencarian YouTube pada kanal yang dituju. Ketersediaan
      episode bergantung pada lisensi dan wilayah.
    </div>
  </main>

  <footer>
    AnimeKita · Katalog anime legal · © 2026
    <br>Hak cipta video tetap milik pemegang hak masing-masing.
  </footer>

  <script>
    const animeList = [
      {
        title: "Spy x Family",
        icon: "🕵️",
        genre: "Action · Comedy",
        query: "Spy x Family site:youtube.com/@MuseIndonesia"
      },
      {
        title: "One Punch Man",
        icon: "👊",
        genre: "Action · Superhero",
        query: "One Punch Man site:youtube.com/@MuseIndonesia"
      },
      {
        title: "Tokyo Revengers",
        icon: "⏳",
        genre: "Action · Drama",
        query: "Tokyo Revengers site:youtube.com/@MuseIndonesia"
      },
      {
        title: "Anime Pilihan",
        icon: "🎬",
        genre: "Beragam genre",
        query: "anime episode Muse Indonesia"
      }
    ];

    const catalog = document.getElementById("catalog");
    const search = document.getElementById("search");

    function renderAnime(keyword = "") {
      const filtered = animeList.filter(anime =>
        (anime.title + " " + anime.genre)
          .toLowerCase().includes(keyword.toLowerCase())
      );

      catalog.innerHTML = "";

      if (filtered.length === 0) {
        catalog.textContent = "Anime tidak ditemukan di katalog.";
        return;
      }

      filtered.forEach(anime => {
        const card = document.createElement("article");
        card.className = "card";

        const poster = document.createElement("div");
        poster.className = "poster";
        poster.textContent = anime.icon;

        const info = document.createElement("div");
        info.className = "info";

        const title = document.createElement("h3");
        title.textContent = anime.title;

        const genre = document.createElement("p");
        genre.textContent = anime.genre;

        const link = document.createElement("a");
        link.className = "watch";
        link.textContent = "Cari di YouTube ▶";
        link.href =
          "https://www.youtube.com/results?search_query=" +
          encodeURIComponent(anime.query);
        link.target = "_blank";
        link.rel = "noopener noreferrer";

        info.append(title, genre, link);
        card.append(poster, info);
        catalog.append(card);
      });
    }

    search.addEventListener("input", event => {
      renderAnime(event.target.value);
    });

    renderAnime();
  </script>
</body>
</html>
